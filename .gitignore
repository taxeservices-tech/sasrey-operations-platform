# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# Local database and recovery copies â€” never commit
/data/
*.db
*.db-shm
*.db-wal

# Local deployment state
.netlify/

# Local dependency backups
node_modules-backup-*/

# Local diagnostics
db-historical-review.ts
tsconfig-effective-check.json
tsconfig-effective.txt

# Recovery copies of source files
*.backup-*
*.before-*.ts
* copy.tsx backup
